          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Game-wide tuning. Most balance changes should only need edits in this file
-- and in Critters.luau.

local Config = {}

Config.GameName = "Catch a Critter"
Config.MaxPlots = 8 -- set the place's Max Players to 8 in Game Settings

-- Movement
Config.WalkSpeed = 22
Config.CarrySpeed = 14
Config.CarrySpeedWithPass = 21

-- Base slots
Config.StartSlots = 6
Config.MaxBoughtSlots = 14
Config.PassBonusSlots = 4
Config.MaxSlots = Config.StartSlots + Config.MaxBoughtSlots + Config.PassBonusSlots -- 24 pedestals per plot

function Config.SlotCost(bought: number): number
	return math.floor(250 * 3 ^ bought)
end

-- Rebirth: resets cash only (critters stay) for a permanent income boost.
Config.RebirthIncomeBonus = 0.5

function Config.RebirthCost(rebirths: number): number
	return 100000 * 5 ^ rebirths
end

-- Permanent bonuses
Config.IndexBonusPerCritter = 0.02 -- +2% income per unique critter discovered
Config.FriendBonus = 0.1 -- +10% income per friend in the server...
Config.FriendBonusMax = 0.3 -- ...up to +30%
Config.SellSeconds = 30 -- a critter sells for 30 seconds of its income

-- Offline earnings (the "grows while you're away" hook)
Config.OfflineCapHours = 4
Config.OfflineCapHoursVIP = 12
Config.OfflineMinSeconds = 60

-- Meadow and field critters
Config.MeadowRadius = 75
Config.PlotRingRadius = 160
Config.BaseFieldCritters = 16
Config.FieldCrittersPerPlayer = 3
Config.MaxFieldCritters = 44
Config.SpawnInterval = 1.5 -- seconds between spawns (divided during storms)

-- Critter Storm: a scheduled event on a fixed global clock, so every server
-- storms at the same time and players can plan to be online for it.
Config.StormEvery = 15 * 60
Config.StormDuration = 3 * 60
Config.StormLuck = 3
Config.StormSpawnMultiplier = 2

Config.WeekendCashMultiplier = 2 -- Saturday and Sunday (UTC)

-- Server luck (developer product, benefits the whole server)
Config.ServerLuckMultiplier = 2
Config.ServerLuckSeconds = 15 * 60

-- Bonk bat
Config.BonkCooldown = 1.2
Config.BonkRange = 10
Config.BonkKnockback = 55

-- Daily streak rewards: cash = max(Min, income * Seconds). Day 7 also grants a Legendary.
Config.DailyRewards = {
	{ Seconds = 120, Min = 100 },
	{ Seconds = 180, Min = 250 },
	{ Seconds = 300, Min = 500 },
	{ Seconds = 480, Min = 1000 },
	{ Seconds = 600, Min = 2000 },
	{ Seconds = 900, Min = 4000 },
	{ Seconds = 1800, Min = 10000, Legendary = true },
}

-- Codes: announce new ones with each update (in your Discord / group / game description).
Config.Codes = {
	LAUNCH = { Cash = 500 },
	CRITTERS = { Cash = 1500 },
	STORMY = { Cash = 5000 },
} :: { [string]: { Cash: number } }

-- Monetization. Create these in the Creator Dashboard and paste the IDs here.
-- An Id of 0 means "not set up yet": the shop shows it as "Coming soon".
export type ShopItem = { Key: string, Id: number, Name: string, Description: string }

Config.GamePasses = {
	{ Key = "DoubleCash", Id = 0, Name = "2x Cash", Description = "Double all critter income, forever." },
	{ Key = "SpeedyCarry", Id = 0, Name = "Speedy Carry", Description = "Run at almost full speed while carrying critters." },
	{ Key = "ExtraSlots", Id = 0, Name = "+4 Base Slots", Description = "Room for 4 more critters in your base." },
	{ Key = "VIP", Id = 0, Name = "VIP", Description = "12 hours of offline earnings (instead of 4) and a VIP chat tag." },
} :: { ShopItem }

Config.Products = {
	{ Key = "ServerLuck", Id = 0, Name = "Server Luck x2", Description = "EVERYONE in the server gets 2x luck for 15 minutes!" },
	{ Key = "CashSmall", Id = 0, Name = "Cash Pack", Description = "10 minutes of income (at least $1K)." },
	{ Key = "CashBig", Id = 0, Name = "Mega Cash Pack", Description = "1 hour of income (at least $10K)." },
} :: { ShopItem }

Config.CashPacks = {
	CashSmall = { Seconds = 600, Min = 1000 },
	CashBig = { Seconds = 3600, Min = 10000 },
} :: { [string]: { Seconds: number, Min: number } }

-- Extra admins (the game's creator is always an admin). Admins can run
-- "admin abuse" chat commands, e.g. /spawn Secret Galaxy, /storm, /luck 10
Config.AdminUserIds = {} :: { number }

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Critters</string>
          <string name="Source"><![CDATA[--!strict
-- Critter, rarity, and mutation definitions plus the random rolls.
-- Rarer critters earn more, run faster, take longer to catch, and wander off sooner.

export type Rarity = {
	Name: string,
	Order: number,
	Color: Color3,
	Weight: number,
	CatchTime: number, -- seconds the Catch prompt must be held
	Speed: number, -- wander speed in the meadow (studs/sec)
	Lifetime: number, -- seconds before it wanders off
	Announce: boolean, -- tell the whole server when one appears or is caught
}

export type Critter = {
	Id: string,
	Name: string,
	Rarity: string,
	Income: number, -- cash per second before multipliers
	Color: Color3,
	Accent: Color3,
	Size: number,
	Feature: string, -- "None" | "Ears" | "Antennae" | "Wings" | "Horns" | "Cap" | "Mane"
	Neon: boolean,
}

export type Mutation = {
	Name: string,
	Multiplier: number,
	Chance: number, -- base chance per spawn, multiplied by luck
	Color: Color3?,
}

local Critters = {}

local rgb = Color3.fromRGB

Critters.Rarities = {
	{ Name = "Common", Order = 1, Color = rgb(190, 190, 190), Weight = 60, CatchTime = 0, Speed = 4, Lifetime = 120, Announce = false },
	{ Name = "Uncommon", Order = 2, Color = rgb(85, 210, 95), Weight = 25, CatchTime = 0.3, Speed = 5, Lifetime = 100, Announce = false },
	{ Name = "Rare", Order = 3, Color = rgb(60, 145, 255), Weight = 10, CatchTime = 0.6, Speed = 6.5, Lifetime = 90, Announce = false },
	{ Name = "Epic", Order = 4, Color = rgb(175, 85, 255), Weight = 3.5, CatchTime = 0.9, Speed = 8, Lifetime = 75, Announce = false },
	{ Name = "Legendary", Order = 5, Color = rgb(255, 200, 40), Weight = 1.2, CatchTime = 1.2, Speed = 10, Lifetime = 60, Announce = true },
	{ Name = "Mythic", Order = 6, Color = rgb(255, 70, 70), Weight = 0.25, CatchTime = 1.5, Speed = 12, Lifetime = 50, Announce = true },
	{ Name = "Secret", Order = 7, Color = rgb(255, 90, 210), Weight = 0.05, CatchTime = 2, Speed = 14, Lifetime = 40, Announce = true },
} :: { Rarity }

local function critter(id: string, name: string, rarity: string, income: number, color: Color3, accent: Color3, size: number, feature: string, neon: boolean?): Critter
	return {
		Id = id,
		Name = name,
		Rarity = rarity,
		Income = income,
		Color = color,
		Accent = accent,
		Size = size,
		Feature = feature,
		Neon = neon == true,
	}
end

Critters.List = {
	critter("pebblepup", "Pebblepup", "Common", 1, rgb(150, 150, 150), rgb(105, 105, 105), 2.2, "Ears"),
	critter("mossmouse", "Mossmouse", "Common", 2, rgb(120, 170, 90), rgb(215, 175, 155), 2, "Ears"),
	critter("blobbit", "Blobbit", "Common", 3, rgb(120, 200, 255), rgb(80, 150, 220), 2.4, "None"),
	critter("puddlefrog", "Puddlefrog", "Uncommon", 7, rgb(90, 200, 110), rgb(240, 240, 120), 2.4, "None"),
	critter("twigbug", "Twigbug", "Uncommon", 9, rgb(140, 100, 60), rgb(90, 160, 60), 2, "Antennae"),
	critter("bunbun", "Bunbun", "Uncommon", 12, rgb(255, 225, 235), rgb(255, 150, 185), 2.4, "Ears"),
	critter("honeybear", "Honeybear", "Rare", 25, rgb(230, 170, 60), rgb(120, 80, 40), 2.8, "Ears"),
	critter("sparkfly", "Sparkfly", "Rare", 32, rgb(255, 240, 120), rgb(180, 220, 255), 2, "Wings"),
	critter("cactoad", "Cactoad", "Rare", 40, rgb(80, 160, 80), rgb(255, 120, 160), 2.6, "Horns"),
	critter("lavapup", "Lavapup", "Epic", 90, rgb(255, 90, 30), rgb(60, 30, 30), 2.8, "Horns"),
	critter("frostfox", "Frostfox", "Epic", 120, rgb(200, 235, 255), rgb(120, 190, 255), 2.8, "Ears"),
	critter("mushmallow", "Mushmallow", "Epic", 150, rgb(240, 230, 220), rgb(230, 60, 60), 2.6, "Cap"),
	critter("thunderhog", "Thunderhog", "Legendary", 400, rgb(255, 220, 60), rgb(60, 60, 120), 3.2, "Mane"),
	critter("moonmoth", "Moonmoth", "Legendary", 550, rgb(200, 200, 255), rgb(120, 100, 220), 2.8, "Wings"),
	critter("crystalwyrm", "Crystalwyrm", "Mythic", 1500, rgb(120, 255, 230), rgb(60, 120, 255), 3.4, "Horns", true),
	critter("solarlion", "Solarlion", "Mythic", 2200, rgb(255, 170, 40), rgb(255, 90, 20), 3.6, "Mane", true),
	critter("voidkitty", "Voidkitty", "Secret", 8000, rgb(35, 20, 55), rgb(175, 80, 255), 3, "Ears"),
	critter("glitchy", "Glitchy", "Secret", 15000, rgb(0, 255, 120), rgb(255, 0, 200), 3, "Antennae", true),
}

-- Checked in the order listed (rarest first). Normal is the fallback.
Critters.Mutations = {
	{ Name = "Galaxy", Multiplier = 10, Chance = 0.0015, Color = rgb(45, 20, 95) },
	{ Name = "Rainbow", Multiplier = 5, Chance = 0.008, Color = rgb(255, 80, 80) },
	{ Name = "Golden", Multiplier = 2, Chance = 0.04, Color = rgb(255, 200, 50) },
	{ Name = "Normal", Multiplier = 1, Chance = 1 },
} :: { Mutation }

local byId: { [string]: Critter } = {}
local rarityByName: { [string]: Rarity } = {}
local mutationByName: { [string]: Mutation } = {}
local byRarity: { [string]: { Critter } } = {}

for _, rarity in Critters.Rarities do
	rarityByName[rarity.Name] = rarity
	byRarity[rarity.Name] = {}
end
for _, def in Critters.List do
	byId[def.Id] = def
	table.insert(byRarity[def.Rarity], def)
end
for _, mutation in Critters.Mutations do
	mutationByName[mutation.Name] = mutation
end

function Critters.Get(id: string): Critter?
	return byId[id]
end

function Critters.GetRarity(name: string): Rarity
	return rarityByName[name] or Critters.Rarities[1]
end

function Critters.GetMutation(name: string): Mutation
	return mutationByName[name] or mutationByName.Normal
end

function Critters.OfRarity(name: string): { Critter }
	return byRarity[name] or {}
end

function Critters.Income(id: string, mutation: string): number
	local def = byId[id]
	if not def then
		return 0
	end
	return def.Income * Critters.GetMutation(mutation).Multiplier
end

-- Luck multiplies the weight of every rarity above Common.
function Critters.RollRarity(luck: number, rng: Random): Rarity
	local total = 0
	for _, rarity in Critters.Rarities do
		total += if rarity.Order == 1 then rarity.Weight else rarity.Weight * luck
	end
	local roll = rng:NextNumber() * total
	for _, rarity in Critters.Rarities do
		roll -= if rarity.Order == 1 then rarity.Weight else rarity.Weight * luck
		if roll <= 0 then
			return rarity
		end
	end
	return Critters.Rarities[1]
end

function Critters.RollCritter(luck: number, rng: Random): Critter
	local pool = Critters.OfRarity(Critters.RollRarity(luck, rng).Name)
	return pool[rng:NextInteger(1, #pool)]
end

function Critters.RollMutation(luck: number, rng: Random): string
	for _, mutation in Critters.Mutations do
		if mutation.Name ~= "Normal" and rng:NextNumber() < mutation.Chance * luck then
			return mutation.Name
		end
	end
	return "Normal"
end

-- Chance (0-1) of each rarity at a given luck, for showing odds in the Index.
function Critters.RarityChance(name: string, luck: number): number
	local total = 0
	local mine = 0
	for _, rarity in Critters.Rarities do
		local weight = if rarity.Order == 1 then rarity.Weight else rarity.Weight * luck
		total += weight
		if rarity.Name == name then
			mine = weight
		end
	end
	return mine / total
end

return Critters
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting for the UI and billboards.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Format.Number(n: number): string
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		return (if negative then "-" else "") .. tostring(math.floor(n))
	end
	local index = 1
	while n >= 1000 and index < #SUFFIXES do
		n /= 1000
		index += 1
	end
	local text
	if n < 10 then
		text = string.format("%.2f", math.floor(n * 100) / 100)
	elseif n < 100 then
		text = string.format("%.1f", math.floor(n * 10) / 10)
	else
		text = tostring(math.floor(n))
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[index]
end

function Format.Money(n: number): string
	return "$" .. Format.Number(n)
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

function Format.Percent(fraction: number): string
	local pct = fraction * 100
	if pct >= 1 then
		return string.format("%.1f%%", pct)
	elseif pct >= 0.01 then
		return string.format("%.2f%%", pct)
	end
	return string.format("%.3f%%", pct)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Creates the remotes on the server; the client waits for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify", -- (text, color?) small toast for one player
	"Announce", -- (text, color?) big banner for everyone
	"Popup", -- (title, body) modal for one player
	"Celebrate", -- (rarityName, mutation) catch effect
	"Knockback", -- (velocity) applied by the client that owns the character
}
local FUNCTIONS = {
	"Request", -- (action, arg) -> { Ok: boolean, Message: string }
}

local folder: Instance
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		for _, name in EVENTS do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		for _, name in FUNCTIONS do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
		folder.Parent = ReplicatedStorage
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Remotes = {}

function Remotes.Event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
